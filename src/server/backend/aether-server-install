if __name__ == '__main__':
    if sys.argv[1:] == ['--graphical']:
        try:
            raw = sys.stdin.buffer.read(65537)
            if len(raw) > 65536:
                raise ValueError('Installation request is too large.')
            main(json.loads(raw))
        except json.JSONDecodeError:
            raise SystemExit('Invalid installation request.')
        except (ValueError, RuntimeError, subprocess.CalledProcessError) as error:
            # Never echo the request or subprocess input: both hold secrets.
            raise SystemExit('Installation stopped: ' + str(error))
    elif sys.argv[1:] == ['--validate']:
        # Used by the automated checks: validate a catalog and exit.
        server_roles.load_catalog()
        print('Server role catalog is valid.')
    elif sys.argv[1:]:
        raise SystemExit('Usage: aether-server-install [--graphical|--validate]')
    else:
        main()
