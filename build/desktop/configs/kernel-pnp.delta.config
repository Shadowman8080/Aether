# Aether plug-and-play kernel options (Windows-style hotplug device classes).
#
# Merged into the desktop kernel by build-desktop-kernel.sh using the kernel's
# own scripts/config tool, then normalized by `make olddefconfig`. Values:
#   y = built into the kernel (always present)
#   m = loadable module; udev auto-loads it by modalias when a device appears
#
# Adding a code path here does not change any released image until the kernel
# is rebuilt on the build host (see build/desktop/README.md).
#
# Webcams / media capture (USB Video Class)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO=m
# USB serial adapters and modems (FTDI/PL2303/CH34x and USB ACM modems)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_ACM=m
# SD / MMC card readers
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
# Windows filesystems on removable media
CONFIG_NTFS3=m
CONFIG_EXFAT=m
# Thunderbolt / USB4 docks and devices
CONFIG_THUNDERBOLT=m
# Real-time clock as a first-class device
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# Joysticks / game controllers
CONFIG_INPUT_JOYDEV=m