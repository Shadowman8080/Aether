#!/usr/bin/env python3
"""Manage only Aether's nftables table; never flush another tool's rules."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

CONFIG = Path('/etc/aether-security/firewall.json')
NFT = '/usr/sbin/nft' if Path('/usr/sbin/nft').exists() else '/usr/bin/nft'

def validate(c):
    if set(c) != {'tcp', 'udp'}:
        raise ValueError('Unexpected firewall configuration fields')
    for ports in c.values():
        if not isinstance(ports, list) or any(type(p) is not int or not 1 <= p <= 65535 for p in ports):
            raise ValueError('Ports must be integers from 1 to 65535')

def rules(c):
    validate(c)
    ports = ''
    for protocol in ('tcp', 'udp'):
        if c[protocol]:
            ports += '        ' + protocol + ' dport { ' + ', '.join(map(str, sorted(set(c[protocol])))) + ' } counter accept\n'
    return '''# Aether owns this table only. Reload replaces its chains atomically.
add table inet aether_filter
flush table inet aether_filter
table inet aether_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state invalid counter drop
        ct state established,related accept
        ip protocol icmp accept
        meta l4proto ipv6-icmp accept
        udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
''' + ports + '''        counter drop
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        counter drop
    }
    chain output {
        type filter hook output priority filter; policy accept;
    }
}
'''

def apply(c):
    text = rules(c)
    subprocess.run([NFT, '--check', '-f', '-'], input=text, text=True, check=True)
    subprocess.run([NFT, '-f', '-'], input=text, text=True, check=True)

def main():
    if os.geteuid():
        raise SystemExit('Use sudo aether-firewall for firewall administration.')
    args = sys.argv[1:]
    if args == ['status']:
        subprocess.run([NFT, 'list', 'table', 'inet', 'aether_filter'], check=True)
        return
    if not args or args[0] not in ('apply', 'check', 'allow-tcp', 'allow-udp', 'remove-tcp', 'remove-udp'):
        raise SystemExit('Usage: aether-firewall apply|check|status|allow-tcp PORT|allow-udp PORT|remove-tcp PORT|remove-udp PORT')
    lockdir = Path('/run/aether-firewall')
    lockdir.mkdir(mode=0o700, exist_ok=True)
    if lockdir.is_symlink() or lockdir.stat().st_uid != 0 or lockdir.stat().st_mode & 0o077:
        raise SystemExit('Unsafe firewall runtime directory.')
    with open(lockdir / 'lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        config = json.loads(CONFIG.read_text())
        validate(config)
        if args == ['check']:
            subprocess.run([NFT, '--check', '-f', '-'], input=rules(config), text=True, check=True)
            return
        if args == ['apply']:
            apply(config)
            return
        if len(args) != 2 or not args[1].isdigit() or not 1 <= int(args[1]) <= 65535:
            raise SystemExit('Provide one valid port number.')
        operation, protocol = args[0].split('-')
        port = int(args[1])
        previous = json.loads(json.dumps(config))
        if operation == 'allow':
            config[protocol] = sorted(set(config[protocol]) | {port})
        else:
            config[protocol] = [p for p in config[protocol] if p != port]
        # Save only after validation and a successful atomic kernel transaction.
        apply(config)
        try:
            fd, name = tempfile.mkstemp(prefix='.firewall-', dir=CONFIG.parent)
            with os.fdopen(fd, 'w') as output:
                json.dump(config, output, indent=2)
                output.write('\n')
                output.flush()
                os.fsync(output.fileno())
            os.replace(name, CONFIG)
        except Exception:
            apply(previous)
            raise
        print('Firewall updated. Explicitly opened ports apply on every network.')

if __name__ == '__main__':
    main()
